# Copie para .env e preencha com valores de desenvolvimento.
# Nunca versione o arquivo .env real — ver docs/definition-of-done.md.

# Repositório de conteúdo — fixo por decisão de projeto (ADR-0001, ADR-0004).
# Não altere estes valores para apontar a outro repositório.
GITHUB_OWNER=cte-zl-ifrn
GITHUB_REPOSITORY=central-ajuda
GITHUB_BASE_BRANCH=main
SAMPLE_DOCUMENT_PATH=_docs/proitec/como-fazer-cursos.md

# OAuth App do GitHub (identidade da pessoa usuária) — NÃO confundir com
# a GitHub App abaixo. São duas aplicações diferentes no GitHub, cada uma
# com seu próprio client id/secret, mesmo tendo nomes parecidos nas
# configurações. Usar o client id/secret da GitHub App aqui por engano
# resulta em "This GitHub App must be configured with a callback URL" ao
# tentar logar — já aconteceu na validação manual da Fase 3.1 (ver
# docs/phase-3.1.5-manual-validation.md).
# Crie uma OAuth App de desenvolvimento em
# https://github.com/settings/developers com callback
# http://localhost:8000/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# GitHub App (leitura e escrita de conteúdo, Fase 3.1) — instalada em
# cte-zl-ifrn/central-ajuda com permissões Contents:Read and write,
# Pull requests:Read and write e Metadata:Read-only (ver ADR-0004).
# Usada apenas pelo backend para falar com a API do GitHub — nunca para
# autenticar a pessoa usuária (isso é a OAuth App acima).
GITHUB_APP_ID=
# Chave privada em formato PEM. Duas formas são aceitas (o backend
# normaliza automaticamente — ver src/config.py):
#   1) colada em uma única linha, com `\n` literais no lugar das quebras
#      de linha reais, por exemplo:
#      GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
#   2) o conteúdo real do .pem, com quebras de linha de verdade, entre
#      aspas duplas (o parser de .env preserva as quebras de linha dentro
#      das aspas).
# Nos dois casos, mantenha o valor entre aspas duplas.
GITHUB_APP_PRIVATE_KEY=
# Opcional: evita uma chamada extra para descobrir o installation id.
GITHUB_APP_INSTALLATION_ID=

# Sessão do portal (cookie assinado, sem armazenamento em banco).
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
SESSION_COOKIE_NAME=portal_session
SESSION_MAX_AGE_SECONDS=1800
OAUTH_STATE_COOKIE_NAME=portal_oauth_state
OAUTH_STATE_MAX_AGE_SECONDS=300

# Frontend e cookies.
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
